#!/usr/bin/env python3
import sys
import os
if os.environ.get("FUNLR_TEST_DOUBLES") != "1":
    raise SystemExit("Refusing to run a synthetic test double outside the test suite")
if any(a in ("--version", "-h", "--help", "version") for a in sys.argv[1:]):
    print("SYNTHETIC TEST DOUBLE shim-1.0")
    raise SystemExit(0)

import os, sys, re
args = sys.argv[1:]
sub = args[0]
fasta = args[-1]

def read_fasta(path):
    recs, name, buf = [], None, []
    with open(path) as fh:
        for line in fh:
            if line.startswith(">"):
                if name is not None:
                    recs.append((name, "".join(buf)))
                name = line[1:].split()[0]
                buf = []
            else:
                buf.append(line.rstrip())
    if name is not None:
        recs.append((name, "".join(buf)))
    return recs

recs = read_fasta(fasta)
if sub == "grep":
    if "-f" in args:
        ids = set()
        with open(args[args.index("-f") + 1]) as fh:
            for line in fh:
                line = line.strip()
                if line:
                    ids.add(line.split()[0])
        keep = [r for r in recs if r[0] in ids]
    elif "-p" in args:
        pattern = args[args.index("-p") + 1]
        if "-r" in args or "--use-regexp" in args:
            pat = re.compile(pattern)
            keep = [r for r in recs if pat.search(r[0])]
        else:
            keep = [r for r in recs if r[0] == pattern]
    else:
        keep = recs
    for name, seq in keep:
        sys.stdout.write(f">{name}\n{seq}\n")
elif sub == "seq":
    sys.stderr.write(f"file\tformat\ttype\tnum_seqs\tsum_len\n{fasta}\tFASTA\tProtein\t{len(recs)}\t{sum(len(s) for _, s in recs)}\n")
